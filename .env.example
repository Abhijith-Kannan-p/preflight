# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local docker compose uses the db service below. For Neon, use its
# connection string with the psycopg driver, e.g.
# postgresql+psycopg://user:pass@ep-xxx.neon.tech/preflight?sslmode=require
DATABASE_URL=postgresql+psycopg://preflight:preflight@localhost:5432/preflight

# --- Auth -------------------------------------------------------------------
# Secret used to sign demo-user JWTs. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# --- LLM gateway ------------------------------------------------------------
# gemini | groq | none   (none = deterministic-only mode, no external AI calls)
LLM_PROVIDER=gemini
# e.g. gemini-2.0-flash (Gemini) or llama-3.3-70b-versatile (Groq)
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
# Seconds before an LLM call is abandoned (one retry, then fallback)
LLM_TIMEOUT_SECONDS=8

# --- Privacy ----------------------------------------------------------------
# Mask confidential terms, emails, phones and ₹ amounts before external calls
MASKING_ENABLED=true

# --- Local models -----------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
# Skip loading local ML models (fast tests / CI). Never set in production.
SKIP_MODEL_LOAD=false

# --- Web --------------------------------------------------------------------
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Public URL of the frontend (used in receipt links and webhook payloads)
PUBLIC_APP_URL=http://localhost:3000

# --- Frontend (Next.js) -----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GITHUB_URL=https://github.com/Abhijith-Kannan-p/preflight
