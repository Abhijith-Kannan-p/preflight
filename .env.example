# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local docker compose uses the db service below. For Neon, use its
# connection string with the psycopg driver, e.g.
# postgresql+psycopg://user:pass@ep-xxx.neon.tech/preflight?sslmode=require
DATABASE_URL=postgresql+psycopg://preflight:preflight@localhost:5432/preflight

# --- Auth -------------------------------------------------------------------
# Secret used to sign demo-user JWTs. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# --- LLM gateway ------------------------------------------------------------
# gemini | groq | none   (none = deterministic-only mode, no external AI calls)
LLM_PROVIDER=gemini
# e.g. gemini-3.5-flash-lite (Gemini) or llama-3.3-70b-versatile (Groq)
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# Seconds before an LLM call is abandoned (one retry, then fallback)
LLM_TIMEOUT_SECONDS=8

# --- Privacy ----------------------------------------------------------------
# Mask confidential terms, emails, phones and ₹ amounts before external calls
MASKING_ENABLED=true

# --- Local models (int8 ONNX, no PyTorch needed) -----------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
# onnx (default, fits 512 MB) | torch (needs backend/requirements-ml.txt)
NLI_BACKEND=onnx
# Pairs per NLI forward pass; each needs ~20 MiB working memory. Use 2 on 512 MB hosts.
NLI_BATCH_SIZE=16
# eager = load at boot | lazy = load on the first review (small hosts that sleep)
MODEL_LOADING=eager
# ONNX graph optimisation: ~20% faster but ~280 MiB more memory for the NLI model
ONNX_OPTIMIZE=false
# Skip loading local ML models (fast tests / CI). Never set in production.
SKIP_MODEL_LOAD=false

# --- Demo bootstrap -----------------------------------------------------------
# Generate the fictional review history and an evaluation run after boot
BOOTSTRAP_DEMO=true
# run = run the 150 labelled claims at boot | precomputed = load data/eval/precomputed_run.json
EVAL_AT_BOOT=run

# --- Web --------------------------------------------------------------------
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Public URL of the frontend (used in receipt links and webhook payloads)
PUBLIC_APP_URL=http://localhost:3000

# --- Frontend (Next.js) -----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GITHUB_URL=https://github.com/Abhijith-Kannan-p/preflight
